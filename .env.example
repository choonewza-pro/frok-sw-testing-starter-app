# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# SQLite: ไฟล์ฐานข้อมูลอยู่ที่ prisma/dev.db (path สัมพัทธ์กับ root ของโปรเจกต์)
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./prisma/dev.db"

BETTER_AUTH_SECRET=

PORT=3030

BETTER_AUTH_URL=http://localhost:3030
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# ไม่บังคับ: ชี้ API หลักสูตรไปที่ mock server ตอนรัน e2e
# ปล่อยว่างไว้จะใช้ API จริงที่ https://api.codingthailand.com/api/course
# มีข้อมูลตัวอย่างให้ที่ docs/fixtures/courses.json
COURSE_API_URL=

ADMIN_USER=admin@test.com
ADMIN_PASSWORD=12345678

USER_USER=user@test.com
USER_PASSWORD=12345678